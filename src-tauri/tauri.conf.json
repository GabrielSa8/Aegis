{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aegis",
  "version": "2.18.3",
  "identifier": "com.aegis.cockpit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Aegis",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "/tmp/**"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$HOME/.aws/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1M0RCRkY1MzdDQTgzODMKUldTRGc4bzM5Yjg5VlFlNXgzeTRrYnFPV0N4ZEwxR2lsRzhHTHl2cThxNHQ3TTZLcGo1Ui9UZUkK",
      "endpoints": [
        "https://github.com/GabrielSa8/Aegis/releases/latest/download/latest.json"
      ]
    }
  }
}
